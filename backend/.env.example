# Copy to backend/.env and fill in. NEVER put these in frontend code or commit .env.

# YouTube Data API v3 key (Google Cloud Console -> Credentials)
YOUTUBE_API_KEY=

# Google OAuth web client (Growth Studio "Connect with Google", read-only YouTube scopes).
# Redirect URI registered in Google Cloud: http://localhost:8000/api/v1/studio/oauth/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/studio/oauth/callback

# Configurable AI provider (any OpenAI-compatible endpoint) — used from Phase 2+
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Database. Default (omit) uses local SQLite file yt_growth.db.
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/yt_growth

# Optional overrides
# YOUTUBE_QUOTA_DAILY_LIMIT=10000
# CACHE_TTL_SECONDS=900
# ENABLE_SCHEDULER=true
# CORS_ORIGINS=["http://localhost:3000"]

# SerpApi (Growth Studio): discovery, trends, transcripts. Free plan = 250 searches/month.
# SERPAPIKEY=
# SERPAPI_MONTHLY_CAP=200
